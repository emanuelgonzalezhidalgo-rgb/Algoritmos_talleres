Algoritmo Area_del_rombo
	
    Definir dMen, dMay, aRmb Como Real
	
    Escribir "Ingrese la diagonal menor:"
    Leer dMen
	
    Escribir "Ingrese la diagonal mayor:"
    Leer dMay
	
    aRmb <- (dMen * dMay) / 2
	
    Escribir "La diagonal menor es: ", dMen
    Escribir "La diagonal mayor es: ", dMay
    Escribir "El area del rombo es: ", aRmb
	
FinAlgoritmo


	


	

