Algoritmo Costo_total_automovil
	
    Definir precio, ganancia, impuesto, costo Como Real
	
    precio <- 35000000
    ganancia <- precio * 12 / 100
    impuesto <- precio * 6 / 100
	
    costo <- precio + ganancia + impuesto
	
    Escribir "Precio del vehiculo: ", precio
    Escribir "Ganancia del vendedor: ", ganancia
    Escribir "Impuesto: ", impuesto
    Escribir "Costo total para el comprador: ", costo
	
FinAlgoritmo








	


	

