Algoritmo Area_del_rectangulo
	
    Definir base, altura, AR Como Real
	
    Escribir "Ingrese la base del rectangulo:"
    Leer base
	
    Escribir "Ingrese la altura del rectangulo:"
    Leer altura
	
    AR <- base * altura
	
    Escribir "La base es: ", base
    Escribir "La altura es: ", altura
    Escribir "El area del rectangulo es: ", AR
	
FinAlgoritmo

	


	

